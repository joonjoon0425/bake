                    "epsilon": 0.00001,
                    "centered": false
                }
            },
            "lr_critic": 1e-3,
            "opt_critic_config": {
                "RmsProp": {
                    "weight_decay": null,
                    "grad_clipping": null,
                    "alpha": 0.99,
                    "momentum": 0.9,
                    "epsilon": 0.00001,
                    "centered": false
                }
            }
        }
    },
    "total_steps": 500000,
    "seed": 12,
    "log_interval": 5000
